# Dependencies
node_modules/
*/node_modules/

# Environment variables & secrets (CRITICAL: NEVER COMMIT)
*.env
*.env.*
*.env.local
config.env
*/config.env
backend/config.env
frontend/.env.local
frontend/.env*.local

# Whitelist safe configuration examples
!*.env.example
!*/.env.example
!*.example
!backend/config.env.example

# Next.js build output & cache
.next/
*/.next/
out/
build/
dist/

# Uploads & User Files (CRITICAL: DO NOT COMMIT USER RESUMES)
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*

# Server Logs
*.log
backend/logs/*
!backend/logs/.gitkeep
logs/

# Test coverage
coverage/

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.tsbuildinfo
next-env.d.ts
